{
    "name": "journal",
    "compatibility_date": "2025-06-21",
    "compatibility_flags": ["nodejs_compat"],
    "assets": {
        "not_found_handling": "single-page-application",
    },
    "main": "./server/src/index.ts",
    "d1_databases": [
        {
            "binding": "DB",
            "database_name": "JOURNAL",
            "database_id": "26ebb31f-ca9d-447e-9ca0-251b5e876790",
            "migrations_dir": "server/migrations",
        },
    ],
    "r2_buckets": [
        {
            "binding": "BUCKET",
            "bucket_name": "journal",
        },
    ],
    "triggers": {
        "crons": ["0 0 * * MON"],
    },
    "ratelimits": [
        {
            "name": "RL_EXPENSIVE",
            "namespace_id": "10008001",
            "simple": {
                "limit": 10,
                "period": 60,
            },
        },
        {
            "name": "RL_CHEAP",
            "namespace_id": "10008002",
            "simple": {
                "limit": 100,
                "period": 60,
            },
        },
    ],
}
